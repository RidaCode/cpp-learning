BasedOnStyle: LLVM
Language: Cpp

IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 80

BreakBeforeBraces: Stroustrup
BreakTemplateDeclarations: Yes
BreakBeforeBinaryOperators: All
AlignOperands: AlignAfterOperator

PointerAlignment: Left
ReferenceAlignment: Left

AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

Cpp11BracedListStyle: FunctionCall
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true

BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true

AllowShortCaseLabelsOnASingleLine: true
AlignConsecutiveShortCaseStatements:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true
  AlignCaseColons: false

# Force one initializer per line, breaking after the colon
PackConstructorInitializers: Never
BreakConstructorInitializers: AfterColon
ConstructorInitializerIndentWidth: 4

# Add spaces before and inside braced initializers: m_x { x }
SpaceBeforeCpp11BracedList: true
