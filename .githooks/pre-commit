#!/usr/bin/env bash
set -euo pipefail

failed=0

while IFS= read -r -d '' path; do
    kind=$(git show ":$path" | file -b -)

    case "$kind" in
        *ELF*|*Mach-O*|*PE32*|*"current ar archive"*)
            echo "Blocked compiled binary: $path" >&2
            failed=1
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

exit "$failed"
